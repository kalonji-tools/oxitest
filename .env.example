# oxitest environment variables
#
# Copy to `.env` and edit values as needed. `.env` is git-ignored; `.env.example`
# is the checked-in template. See CONTRIBUTING.md for context.
#
# Almost all vars are unnecessary inside `devenv shell` (Nix takes care of it).
# This file exists so contributors outside Nix know which vars matter.

# Enable Rust tracing output. Any tracing-subscriber env-filter string.
# Example: `RUST_LOG=oxitest=debug,warn` shows debug lines from the crate.
RUST_LOG=

# Where maturin / uv find the project's Python virtualenv. Inside devenv this is
# set to the shared `.devenv/state/venv/` path via UV_PROJECT_ENVIRONMENT below;
# outside devenv, leave unset to use `.venv` at the repo root.
VIRTUAL_ENV=

# Set by devenv. If you're running the justfile outside devenv, leave this
# empty — the justfile falls back to `.venv`.
UV_PROJECT_ENVIRONMENT=

# Set automatically by Nix. If non-empty, the justfile unsets
# `_PYTHON_SYSCONFIGDATA_NAME` and `PYTHONPATH` before invoking maturin so it
# picks the correct ABI tag. Do NOT set this by hand.
IN_NIX_SHELL=
