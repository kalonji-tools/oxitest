# =============================================================================
# Project-specific
# =============================================================================

# Devenv / Nix
.devenv/
.devenv.flake.nix
# direnv's per-directory cache of the exported environment (.envrc is tracked)
.direnv/
# `.config/*` not `.config/` — git will not descend into an excluded
# directory, so a `!` negation on a child of it never fires. wt.toml has been
# tracked since 38b65b33, the same commit that added the rule, so the negation
# below has never done anything; untracked, the file would not come back.
.config/*
!.config/wt.toml
result

# Worktrees
.worktrees/

# Python extension modules
*.pyd

# oxitest / pytest caches
.oxitest_cache/
.pytest_cache/

# Benchmarks (generated)
benchmarks/generated/
benchmarks/baseline.json
benchmarks/results.json
benchmarks/results_*.json

# Test output
junit.xml

# Bacon
.bacon-locations

# Agent tooling artifacts.
#
# These are NOT ignored merely as noise. Several mandated skills instruct the
# agent to save an artifact here AND commit it; this repo keeps the durable
# copy as a PR or issue comment instead (#1741). Ignoring the paths lets the
# skills' save step succeed while making their commit step impossible, which
# is the whole override. See docs/agents/skill-contracts.md, cause A.
.superpowers/
docs/superpowers/
plans/

# MkDocs build output
docs/site/
docs/internals/book/

# End of https://www.toptal.com/developers/gitignore/api/rust,python,linux,visualstudiocode,jetbrains,macos,windows,vim
